{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nurb",
  "version": "0.26.0",
  "identifier": "io.github.babgev.nurb",
  "build": {
    "beforeDevCommand": "npm run stage && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run stage && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "nurb",
        "titleBarStyle": "Overlay",
        "theme": "Dark",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 22 },
        "backgroundColor": "#16181d",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "ipc: http://ipc.localhost",
        "frame-src": "'self' http://127.0.0.1:* http://localhost:*"
      }
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": false,
    "externalBin": ["binaries/uv"],
    "resources": ["resources/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
